<?xml version="1.0" encoding="utf-8"?>
<!--
    Schema for per-node CUEMS settings.

    The instance file this schema validates is deployed to:
        /etc/cuems/settings.xml        (default)
        $CUEMS_CONF_PATH/settings.xml  (when the environment variable
                                         is set; precedence defined in
                                         cuemsutils.tools.ConfigManager)

    A reference instance is generated from this schema, not hand-maintained
    alongside it (feature 008, FR-034): see
    cuemsutils.xml.descriptor.generate_settings_example. A schema change
    that adds or removes a required field is caught there — at generation
    time — rather than relying on a second file nothing enforced agreement
    with. In the future, the in-dev cuems-hardware-discovery project will
    consume such a reference, probe node hardware, and populate the final
    deployed file automatically.
-->
<xs:schema targetNamespace="https://stagelab.coop/cuems/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:cms="https://stagelab.coop/cuems/">
    <xs:element name="CuemsSettings">
            <xs:annotation>
                <xs:documentation xml:lang="en">Node-authored settings. Sole writer: cuems-init-node (feature 011, F1); the engine, the editor, cuems-common tools and cuems-power-bridge read it. Identity (node/uuid, node/mac) is minted only by cuemsutils.tools.Uuid through that tool.</xs:documentation>
                <xs:appinfo>
                    <cms:writer scope="document">cuems-init-node</cms:writer>
                </xs:appinfo>
            </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Settings">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="conf_path" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="library_path" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="tmp_path" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="database_name" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="show_lock_file" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="editor_url" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="controller_url" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="templates_path" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="controller_interfaces_template" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="node_interfaces_template" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <xs:element name="controller_lock_file" type="xs:string" minOccurs="1" maxOccurs="1" />
                            <!-- Node settings -->
                            <xs:element name="node" type="cms:NodeConfType" minOccurs="1" maxOccurs="1"></xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <!-- Document-property version marker (feature 008, ITEM E, FR-048a).
                 Not a domain field: excluded from spec._derive_attributes and
                 every wire projection (research R1). Absent means version 1
                 (FR-050); this schema is version 2: F3 retired audio_cards and
                 universes, with a registered settings 1->2 conversion, so a
                 document in the field carrying them still loads
                 (specs/planning/etc-cuems-first-install.md section 8.5). The
                 authority is versioning.CURRENT_VERSION, not this comment. -->
            <xs:attribute name="doc_version" type="xs:positiveInteger" use="optional" />
        </xs:complexType>
    </xs:element>


    <!-- TYPES DEFINITIONS -->
    <xs:complexType name="NodeConfType">
        <xs:sequence>
            <xs:element name="uuid" type="cms:NodeUuidType" />
            <xs:element name="mac" type="cms:NonEmptyString" />
            <xs:element name="osc_dest_host" type="cms:NonEmptyString" />
            <xs:element name="oscquery_ws_port" type="cms:NonPrivilegedPort" />
            <xs:element name="oscquery_osc_port" type="cms:NonPrivilegedPort" />
            <xs:element name="websocket_port" type="cms:NonPrivilegedPort" />
            <xs:element name="load_timeout" type="xs:positiveInteger" />
            <xs:element name="nodeconf_timeout" type="xs:positiveInteger" />
            <xs:element name="discovery_timeout" type="xs:positiveInteger" />
            <xs:element name="mtc_port" type="xs:string" />
            <xs:element name="osc_in_port_base" type="cms:NonPrivilegedPort" />
            <xs:element name="nng_hub_port" type="cms:NonPrivilegedPort" />
            <xs:element name="gradient_osc_port" type="cms:NonPrivilegedPort" />
            <!-- Container: the repeated player is inside it, so a single
                 audiomixer sibling is not dropped by the converter (R2). -->
            <xs:element name="players" type="cms:PlayersType" minOccurs="0" maxOccurs="1" />
            <xs:element name="audiomixer" type="cms:AudioMixerType" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PlayerType">
        <xs:sequence>
            <xs:element name="path" type="cms:NonEmptyString" />
            <xs:element name="args" type="xs:string" />
        </xs:sequence>
    </xs:complexType>

    <!-- class is not on PlayerType: AudioMixerType extends that and has no
         device class (FR-040a). An alternative type must derive from the
         element's declared type, so player is PlayerClassType. -->
    <xs:complexType name="PlayerClassType">
        <xs:complexContent>
            <xs:extension base="cms:PlayerType">
                <xs:attribute name="class" type="cms:NonEmptyString" use="required" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="PlayersType">
        <xs:sequence>
            <xs:element name="player" minOccurs="0" maxOccurs="unbounded" type="cms:PlayerClassType">
                <xs:alternative test="@class='video'" type="cms:VideoPlayerType" />
                <xs:alternative test="@class='audio'" type="cms:AudioPlayerType" />
                <xs:alternative test="@class='dmx'" type="cms:DmxPlayerType" />
                <xs:alternative type="cms:PlayerClassType" />
            </xs:element>
        </xs:sequence>
        <xs:assert test="count(player) = count(distinct-values(player/@class))" />
    </xs:complexType>

    <xs:complexType name="VideoPlayerType">
        <xs:complexContent>
            <xs:extension base="cms:PlayerClassType">
                <xs:sequence>
                    <xs:element name="outputs" type="xs:positiveInteger" />
                    <xs:element name="osc_port" type="cms:NonPrivilegedPort" minOccurs="0" />
                    <xs:element name="output_latency_ms" type="cms:AutoOrIntLatencyMsType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="AudioPlayerType">
        <xs:complexContent>
            <xs:extension base="cms:PlayerClassType">
                <xs:sequence>
                    <xs:element name="output_latency_ms" type="cms:AutoOrIntLatencyMsType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="AudioMixerType">
        <xs:complexContent>
            <xs:extension base="cms:PlayerType">
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="DmxPlayerType">
        <xs:complexContent>
            <xs:extension base="cms:PlayerClassType">
                <xs:sequence>
                    <xs:element name="output_latency_ms" type="cms:IntLatencyMsType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:simpleType name="BoolType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="True" />
            <xs:enumeration value="False" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DateType">
        <xs:restriction base="xs:dateTime">
            <xs:minInclusive value="2020-01-01T00:00:00"></xs:minInclusive>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:pattern value=".*[^\s].*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonPrivilegedPort">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="1024" />
            <xs:maxInclusive value="65535" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Audio and video: "auto" defers to the binary's built-in default
         or auto-calibration path (JACK query for audio; 33 ms hard-coded
         default for video, reserved for a future refresh-rate-derived
         heuristic). An integer is an explicit override in ms. -->
    <xs:simpleType name="AutoOrIntLatencyMsType">
        <xs:union>
            <xs:simpleType>
                <xs:restriction base="xs:nonNegativeInteger">
                    <xs:maxInclusive value="500" />
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="auto" />
                </xs:restriction>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>

    <!-- DMX: integer only. No self-measurement path exists (no fixture-
         response rig); "auto" would imply magic that doesn't exist.
         Absent element = hard-coded 35 ms default in the binary. -->
    <xs:simpleType name="IntLatencyMsType">
        <xs:restriction base="xs:nonNegativeInteger">
            <xs:maxInclusive value="500" />
        </xs:restriction>
    </xs:simpleType>

    <!-- feature 012: uuid4 convergence (FR-020, FR-021c, data-model §1.2).
         THREE declarations, deliberately, not one widened pattern: the
         converged shape, the not-provisioned sentinel, and the union of them
         that every node-identity element names. The two halves exist to be
         nameable, testable and removable on their own; only the union is
         referenced.

         "Converged" means uuid4 lowercase and ONLY that. The sentinel is
         ADMITTED and never converged — feature 011 established it as the
         coherent state of a freshly installed node, and the package's own
         build-time generation emits it, so a pattern that refused it would make
         every new node unloadable (M-f).

         Admitted by UNION, not by loosening: the sentinel is an enumeration of
         exactly one string, so no other nil-like value becomes valid.

         Declared here in all three narrowed schemas because none of the six
         includes or imports another — they share a target namespace and nothing
         else (research R13). NonEmptyString, declared identically in four
         schemas, is the precedent. The anti-drift guarantee is therefore a
         TEST, not a schema mechanism: the three names are recorded in
         tests/contract/test_schema_name_overlap.py's KNOWN_IDENTICAL_DUPLICATES
         (FR-021d), whose drift test fails the moment one copy gains a facet the
         others lack. -->
    <xs:simpleType name="ConvergedUuidType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}" />
            <xs:minLength value="36" />
            <xs:maxLength value="36" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NotProvisionedUuidType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="00000000-0000-0000-0000-000000000000" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NodeUuidType">
        <xs:union memberTypes="cms:ConvergedUuidType cms:NotProvisionedUuidType" />
    </xs:simpleType>

</xs:schema>
