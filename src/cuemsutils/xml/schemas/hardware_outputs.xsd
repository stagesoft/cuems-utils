<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="https://stagelab.coop/cuems/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:cms="https://stagelab.coop/cuems/">
    <xs:element name="CuemsHardwareOutputs">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="video_outputs" type="cms:HardwareOutputsType" />
                <xs:element name="audio_outputs" type="cms:HardwareOutputsType" />
            </xs:sequence>
            <!-- Document-property version marker (feature 008, ITEM E, FR-048a).
                 Not a domain field: excluded from spec._derive_attributes and
                 every wire projection (research R1). Absent means version 1
                 (FR-050); this schema is version 2: F4 retired
                 default_video_output and default_audio_output (authored
                 choices in a discovered document, already declared in
                 project_mappings), with a registered hardware_outputs 1->2
                 conversion (specs/planning/etc-cuems-first-install.md section
                 8.5). The authority is versioning.CURRENT_VERSION, not this
                 comment. -->
            <xs:attribute name="doc_version" type="xs:positiveInteger" use="optional" />
        </xs:complexType>
    </xs:element>

    <!-- TYPES DEFINITIONS -->
    <xs:complexType name="HardwareOutputsType">
        <xs:sequence>
            <xs:element name="output" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

</xs:schema>
