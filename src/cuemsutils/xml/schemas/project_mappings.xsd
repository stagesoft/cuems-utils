<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="https://stagelab.coop/cuems/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:cms="https://stagelab.coop/cuems/">
    <xs:element name="CuemsProjectMappings">
            <xs:annotation>
                <xs:documentation xml:lang="en">Project-authored mappings. Sole writer of a project's mappings.xml: cuems-editor. The node-scoped default_mappings.xml is written by cuems-init-node until feature 014 retires it (F1, feature 011).</xs:documentation>
                <xs:appinfo>
                    <cms:writer scope="document">cuems-editor</cms:writer>
                    <cms:writer scope="default_mappings.xml">cuems-init-node</cms:writer>
                </xs:appinfo>
            </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="number_of_nodes" minOccurs="1" maxOccurs="1" type="xs:nonNegativeInteger" />
                <xs:element name="default_audio_input" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="default_audio_output" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="default_video_input" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="default_video_output" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="default_dmx_input" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="default_dmx_output" minOccurs="1" maxOccurs="1" type="xs:string" />
                <xs:element name="nodes" minOccurs="1" maxOccurs="1" type="cms:NodesType" />
                <xs:element name="new_nodes" minOccurs="1" maxOccurs="1" type="cms:NewNodesType" />
            </xs:sequence>
            <!-- Document-property version marker (feature 008, ITEM E, FR-048a).
                 Not a domain field: excluded from spec._derive_attributes and
                 every wire projection (research R1). Absent means version 1
                 (FR-050); this schema stays at version 1 (FR-048b). -->
            <xs:attribute name="doc_version" type="xs:positiveInteger" use="optional" />
        </xs:complexType>
    </xs:element>

    <xs:complexType name="NewNodesType">
        <xs:sequence>
            <xs:element name="node" minOccurs="0" maxOccurs="unbounded" type="cms:NodeMappingType" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="NodesType">
        <xs:sequence>
            <xs:element name="node" minOccurs="1" maxOccurs="unbounded" type="cms:NodeMappingType" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="NodeMappingType">
        <xs:sequence>
            <xs:element name="uuid" minOccurs="1" maxOccurs="1" type="cms:NodeUuidType" />
            <xs:element name="mac" minOccurs="1" maxOccurs="1" type="cms:NonEmptyString" />
            <xs:element name="audio" minOccurs="0" maxOccurs="1" type="cms:DeviceType" />
            <xs:element name="video" minOccurs="0" maxOccurs="1" type="cms:VideoDeviceType" />
            <xs:element name="dmx" minOccurs="0" maxOccurs="1" type="cms:DeviceType" />
        </xs:sequence>
    </xs:complexType>

    <!-- Audio and DMX: id + name + mappings, no canvas_region -->
    <xs:complexType name="DeviceType">
        <xs:sequence>
            <xs:element name="outputs" minOccurs="0" maxOccurs="unbounded" type="cms:PutGroupType" />
            <xs:element name="inputs" minOccurs="0" maxOccurs="unbounded" type="cms:PutGroupType" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PutGroupType">
        <xs:choice>
            <xs:element name="output" minOccurs="0" maxOccurs="unbounded" type="cms:PutType"/>
            <xs:element name="input" minOccurs="0" maxOccurs="unbounded" type="cms:PutType"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="PutType">
        <xs:sequence>
            <xs:element name="id" minOccurs="1" maxOccurs="1" type="xs:nonNegativeInteger" />
            <xs:element name="name" minOccurs="1" maxOccurs="1" type="cms:NonEmptyString" />
            <xs:element name="mappings">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="mapped_to" minOccurs="1" maxOccurs="unbounded" type="xs:string" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Video: id + name + optional canvas_region + mappings.
         canvas_region present => custom template (authorable slot on this
           node). IMPORTANT: this is a UI-template hint only — it exposes
           a named custom slot to the editor's output picker as a default
           starting rectangle when authoring custom-region cues. It does
           NOT describe physical monitor layout or output resolution:
           display layout comes from videocomposer's DRM detection, and
           per-cue custom regions are carried separately in
           script.xsd's VideoCueOutput.canvas_region (see CueOutput.py
           VideoCueOutput doc). At most one entry per node may carry
           canvas_region (validated in Settings.process_xml_dict).
         canvas_region absent  => monitor alias (resolved by videocomposer). -->
    <xs:complexType name="VideoDeviceType">
        <xs:sequence>
            <xs:element name="outputs" minOccurs="0" maxOccurs="unbounded" type="cms:VideoPutGroupType" />
            <xs:element name="inputs" minOccurs="0" maxOccurs="unbounded" type="cms:VideoPutGroupType" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="VideoPutGroupType">
        <xs:choice>
            <xs:element name="output" minOccurs="0" maxOccurs="unbounded" type="cms:VideoPutType"/>
            <xs:element name="input" minOccurs="0" maxOccurs="unbounded" type="cms:VideoPutType"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="VideoPutType">
        <xs:sequence>
            <xs:element name="id" minOccurs="1" maxOccurs="1" type="xs:nonNegativeInteger" />
            <xs:element name="name" minOccurs="1" maxOccurs="1" type="cms:NonEmptyString" />
            <xs:element name="canvas_region" minOccurs="0" maxOccurs="1" type="cms:CanvasRegionType" />
            <xs:element name="mappings">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="mapped_to" minOccurs="1" maxOccurs="unbounded" type="xs:string" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- DUPLICATE: CanvasRegionType / UnitFloat / PositiveUnitFloat are also
         defined in script.xsd. Keep both copies in sync.
         See docs/canvas_region.md for semantics, V1 caps, and deferred items
         (aspect ratio, z-order, off-canvas, multi-custom). -->
    <xs:complexType name="CanvasRegionType">
        <xs:sequence>
            <xs:element name="x" type="cms:UnitFloat" />
            <xs:element name="y" type="cms:UnitFloat" />
            <xs:element name="width" type="cms:PositiveUnitFloat" />
            <xs:element name="height" type="cms:PositiveUnitFloat" />
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="UnitFloat">
        <xs:restriction base="xs:float">
            <xs:minInclusive value="0" />
            <xs:maxInclusive value="1" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PositiveUnitFloat">
        <xs:restriction base="xs:float">
            <xs:minExclusive value="0" />
            <xs:maxInclusive value="1" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="MappedToType">
        <xs:sequence>
            <xs:element name="uuid" minOccurs="1" maxOccurs="1" type="xs:string"></xs:element>
            <xs:element name="name" minOccurs="1" maxOccurs="1" type="xs:string"></xs:element>
        </xs:sequence>
    </xs:complexType>


    <!-- feature 012: uuid4 convergence (FR-020, FR-021c, data-model §1.2).
         THREE declarations, deliberately, not one widened pattern: the
         converged shape, the not-provisioned sentinel, and the union of them
         that every node-identity element names. The two halves exist to be
         nameable, testable and removable on their own; only the union is
         referenced.

         "Converged" means uuid4 lowercase and ONLY that. The sentinel is
         ADMITTED and never converged — feature 011 established it as the
         coherent state of a freshly installed node, and the package's own
         build-time generation emits it, so a pattern that refused it would make
         every new node unloadable (M-f).

         Admitted by UNION, not by loosening: the sentinel is an enumeration of
         exactly one string, so no other nil-like value becomes valid.

         Declared here in all three narrowed schemas because none of the six
         includes or imports another — they share a target namespace and nothing
         else (research R13). NonEmptyString, declared identically in four
         schemas, is the precedent. The anti-drift guarantee is therefore a
         TEST, not a schema mechanism: the three names are recorded in
         tests/contract/test_schema_name_overlap.py's KNOWN_IDENTICAL_DUPLICATES
         (FR-021d), whose drift test fails the moment one copy gains a facet the
         others lack. -->
    <xs:simpleType name="ConvergedUuidType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}" />
            <xs:minLength value="36" />
            <xs:maxLength value="36" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NotProvisionedUuidType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="00000000-0000-0000-0000-000000000000" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NodeUuidType">
        <xs:union memberTypes="cms:ConvergedUuidType cms:NotProvisionedUuidType" />
    </xs:simpleType>

    <xs:simpleType name="NonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:pattern value=".*[^\s].*" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
