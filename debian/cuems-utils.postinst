#!/bin/sh
# SPDX-FileCopyrightText: 2026 Stagelab Coop SCCL
# SPDX-License-Identifier: GPL-3.0-or-later
#
# cuems-utils postinst — feature 011, /etc/cuems first install.
#
# THIS SCRIPT MUST NEVER EXIT NON-ZERO. cuems-utils is the base package of the
# whole stack: a non-zero exit here leaves it half-configured and every
# dependent CUEMS package fails to configure after it, on every node the
# upgrade reaches (specs/011-etc-cuems-first-install/spec.md, "the constraint
# that dominates"). Every step below either succeeds or degrades, warns, and
# continues; the last line is `exit 0` unconditionally.
#
# Nothing under /etc/cuems is a conffile (D5). The six schemas are the only
# files this script REPLACES, on every configure, so the installed schema always
# matches the installed library (D4). The three documents are created only when
# absent (D5/D13) and an existing one is never modified — including one carrying
# the sentinel identity, which `cuems-init-node --check` reports and a plain
# `cuems-init-node` run repairs.
#
# Contract: specs/011-etc-cuems-first-install/contracts/packaging.md.

#DEBHELPER#

# dh-virtualenv's autoscript, injected at the token above, begins with `set -e`
# (measured: /usr/share/debhelper/autoscripts/postinst-dh-virtualenv). Under it,
# a failing `install`, `timeout` or tool call below would exit this script
# non-zero — the one outcome this script exists to prevent. Undo it first.
set +e

# Path overrides for the script-level tests (contract packaging.md). An EMPTY
# CUEMS_INIT_NODE means "skip the tool step" (the `-` form keeps an empty value).
CUEMS_ETC="${CUEMS_ETC:-/etc/cuems}"
CUEMS_SHARE="${CUEMS_SHARE:-/usr/share/cuems}"
CUEMS_STATE="${CUEMS_STATE:-/var/lib/cuems-utils}"
CUEMS_INIT_NODE="${CUEMS_INIT_NODE-/usr/lib/cuems/bin/cuems-init-node}"
CUEMS_INIT_TIMEOUT="${CUEMS_INIT_TIMEOUT:-60s}"
# An EMPTY CUEMS_RESHAPE skips the reshape step (tests), as for CUEMS_INIT_NODE.
CUEMS_RESHAPE="${CUEMS_RESHAPE-/usr/lib/cuems/bin/cuems-reshape-devices}"
CUEMS_RESHAPE_TIMEOUT="${CUEMS_RESHAPE_TIMEOUT:-60s}"

warn() {
    echo "WARNING: cuems-utils postinst: $*" >&2
}

install_schemas() {
    # D4: always, replacing whatever is there. A missing source is a broken
    # package rather than a broken host; say so and carry on.
    for name in settings network_map project_mappings project_settings script hardware_outputs; do
        src="$CUEMS_SHARE/schemas/$name.xsd"
        if [ -f "$src" ]; then
            install -m 0644 "$src" "$CUEMS_ETC/$name.xsd" \
                || warn "could not install $CUEMS_ETC/$name.xsd"
        else
            warn "$src is missing; $CUEMS_ETC/$name.xsd left as it is"
        fi
    done
}

reshape_configuration() {
    # 010 T040 (FR-094): a field node's /etc/cuems documents are in the pre-013
    # device shape, which the load path refuses — the reshape has no version
    # step, so convert-on-read cannot cover it — and the services read them at
    # start. Reshape them here, before cuems-init-node reads settings.xml, and
    # before any dependent package restarts a service (dpkg configures this
    # package first). EXPLICIT PATHS, the documents directly in $CUEMS_ETC
    # only: the tool's own discovery would follow settings.xml's library_path
    # into the show library, and that stays an operator command (FR-095b).
    # The tool backs up each document it rewrites and leaves current ones alone.
    [ -n "$CUEMS_RESHAPE" ] || return 0
    set --
    for doc in "$CUEMS_ETC"/*.xml; do
        [ -f "$doc" ] && set -- "$@" "$doc"
    done
    [ "$#" -gt 0 ] || return 0
    if [ ! -x "$CUEMS_RESHAPE" ]; then
        warn "$CUEMS_RESHAPE is not executable; $CUEMS_ETC not reshaped. Run: cuems-reshape-devices --check"
        return 0
    fi
    timeout "$CUEMS_RESHAPE_TIMEOUT" "$CUEMS_RESHAPE" "$@" \
        || warn "cuems-reshape-devices did not complete over $CUEMS_ETC ($CUEMS_RESHAPE_TIMEOUT limit); services may refuse an old-shape document. Run: cuems-reshape-devices --check"
}

#: The one wording for the sentinel state, shared with cuems-init-node --check.
NOT_PROVISIONED="NOT PROVISIONED"

install_missing_documents() {
    # D5/D13: only where absent, per file. A present document — real identity,
    # sentinel, a cuems-common stub, or garbage — is never touched here;
    # `cuems-init-node --check` reports it and a plain run repairs it.
    for name in settings.xml network_map.xml default_mappings.xml; do
        if [ ! -e "$CUEMS_ETC/$name" ]; then
            src="$CUEMS_SHARE/defaults/$name"
            if [ -f "$src" ]; then
                install -m 0644 "$src" "$CUEMS_ETC/$name" \
                    || warn "could not install the pristine $CUEMS_ETC/$name"
            else
                warn "$src is missing; $CUEMS_ETC/$name not created"
            fi
        fi
    done
}

case "$1" in
    configure)
        install -d -m 0755 "$CUEMS_ETC" || warn "could not create $CUEMS_ETC"
        install_schemas
        reshape_configuration
        # D13: mint an identity and write a coherent triple — only where absent
        # (--install-missing), reading no operator input (--no-overlay), under a
        # hard timeout: a hang here blocks the stack as surely as a non-zero
        # exit (research R8). On any failure the pristine placeholders below are
        # the fallback and the node is NOT PROVISIONED until an operator runs the
        # tool. An empty CUEMS_INIT_NODE skips the step (tests).
        _tool_ok=1
        if [ -n "$CUEMS_INIT_NODE" ]; then
            install -d -m 0755 "$CUEMS_STATE/init-node" || warn "could not create $CUEMS_STATE/init-node"
            if [ -x "$CUEMS_INIT_NODE" ]; then
                if timeout "$CUEMS_INIT_TIMEOUT" "$CUEMS_INIT_NODE" --no-overlay --install-missing; then
                    _tool_ok=0
                else
                    warn "cuems-init-node failed or timed out ($CUEMS_INIT_TIMEOUT); installing pristine placeholders"
                fi
            else
                warn "$CUEMS_INIT_NODE is not executable; installing pristine placeholders"
            fi
        fi
        install_missing_documents
        if [ "$_tool_ok" != 0 ]; then
            warn "this node is $NOT_PROVISIONED (sentinel identity). Run: cuems-init-node"
        fi
        ;;
    *)
        ;;
esac

exit 0
