#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Stagelab Coop SCCL
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileContributor: Ion Reguera <ion@stagelab.coop>
export DH_VIRTUALENV_INSTALL_ROOT=/usr/lib
export DH_VERBOSE = 1


%:
	dh $@ --with python-virtualenv

# Pin the interpreter by absolute path. "--python python3" resolves through
# PATH, so building on a dev box with pyenv active bakes the builder's private
# interpreter into the venv (pyvenv.cfg home / bin/python symlink), producing a
# package whose /usr/lib/cuems/bin/python is a broken symlink on every target
# host. Target hosts always have /usr/bin/python3 = 3.11 on bookworm.
override_dh_virtualenv:
	dh_virtualenv --python /usr/bin/python3 --install-suffix cuems --use-system-packages
	# CACHEDIR.TAG marks the venv root as a cache directory. Newer virtualenv
	# writes it, and cuems-engine 0.1.0rc4/rc5 and cuems-editor 0.1.0rc1-5 ship
	# the same path, so dpkg refuses to install one over the other ("trying to
	# overwrite"). Nothing reads it at runtime: no package ships it
	# (same fix as cuems-power-bridge 0.3.0-8).
	rm -f debian/cuems-utils/usr/lib/cuems/CACHEDIR.TAG
