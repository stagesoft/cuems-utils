#!/usr/bin/make -f
export DH_VIRTUALENV_INSTALL_ROOT=/usr/lib
export DH_VERBOSE = 1


%:
	dh $@ --with python-virtualenv

# Pin the interpreter by absolute path. "--python python3" resolves through
# PATH, so building on a dev box with pyenv active bakes the builder's private
# interpreter into the venv (pyvenv.cfg home / bin/python symlink), producing a
# package whose /usr/lib/cuems/bin/python is a broken symlink on every target
# host. Target hosts always have /usr/bin/python3 = 3.11 on bookworm.
override_dh_virtualenv:
	dh_virtualenv --python /usr/bin/python3 --install-suffix cuems --use-system-packages
	# Feature 011 (D4): the six schemas ship to /usr/share/cuems/schemas as
	# package content; postinst copies them to /etc/cuems on every configure,
	# so the installed schema always matches the installed library and is
	# never a conffile (D5). Version-free paths only (FR-044).
	install -d debian/cuems-utils/usr/share/cuems/schemas
	install -m 0644 src/cuemsutils/xml/schemas/*.xsd debian/cuems-utils/usr/share/cuems/schemas/
	# Feature 011 (D2/D3): the three default documents are generated from the
	# descriptor and the seed values by the JUST-BUILT venv's interpreter —
	# reached through bin/python, never through lib/python3.N (FR-044) — and
	# carry the reserved sentinel identity, never a minted uuid, so the build is
	# reproducible. make_defaults generates twice and refuses on any difference.
	install -d debian/cuems-utils/usr/share/cuems/defaults
	debian/cuems-utils/usr/lib/cuems/bin/python -m cuemsutils.xml.make_defaults \
	    --out debian/cuems-utils/usr/share/cuems/defaults
	install -m 0644 src/cuemsutils/defaults/system-defaults.toml \
	    debian/cuems-utils/usr/share/cuems/defaults/